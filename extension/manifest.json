{
  "manifest_version": 3,
  "name": "PMS — UMS Group List sync",
  "version": "1.1.0",
  "description": "Every hour, exports the Group List from your logged-in UMS tab and hands it to the Faiz E Hashemi PMS.",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "UMS sync", "default_icon": "icon.png" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "scripting", "tabs", "notifications"],
  "host_permissions": [
    "https://pms.raajsoftware.com/*",
    "https://faizehashemi.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://pms.raajsoftware.com/*", "https://faizehashemi.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
